# MDInsights Environment Configuration Template
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=sqlite:///./data/mdinsights.db
DATA_DIR=./data

# Azure OpenAI Configuration
# Get these from Azure Portal -> Azure OpenAI Service -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Microsoft Graph Configuration (for email delivery in Phase 5)
# Get these from Azure Portal -> Azure AD -> App Registrations
MICROSOFT_TENANT_ID=your_tenant_id_here
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
SENDER_EMAIL=intelligence@yourcompany.com

# Apify Configuration (for web scraping)
# Get this from Apify Console -> Settings -> Integrations -> API Token
APIFY_TOKEN=your_apify_token_here

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

# Report Configuration
COMPANY_NAME=Marsh
