# ============================================================================
# MDInsights Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env file to source control (already in .gitignore)
#
# Quick Start:
#   1. Copy: cp .env.example .env
#   2. Fill in values following instructions below
#   3. Run seed: python scripts/seed_sources.py
#   4. Test: python -m app.main run-pipeline
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# SQLite database path and data directory location
# Default: Stores database in ./data/mdinsights.db (relative to project root)
# Change only if you need a different location
DATABASE_URL=sqlite:///./data/mdinsights.db
DATA_DIR=./data

# ----------------------------------------------------------------------------
# AZURE OPENAI CONFIGURATION
# ----------------------------------------------------------------------------
# Required for AI classification and report generation (Phase 4+)
#
# Where to find these values:
#   1. Navigate to: https://portal.azure.com/
#   2. Search for: "Azure OpenAI"
#   3. Select your Azure OpenAI resource
#   4. Go to: Keys and Endpoint (left sidebar)
#   5. Copy:
#      - Endpoint URL → AZURE_OPENAI_ENDPOINT
#      - KEY 1 → AZURE_OPENAI_API_KEY
#   6. Go to: Model deployments (left sidebar)
#   7. Note your deployment name → AZURE_OPENAI_DEPLOYMENT
#
# Endpoint URL (must end with trailing slash)
# Example: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# API Key (either KEY 1 or KEY 2 from portal)
AZURE_OPENAI_API_KEY=your_api_key_here

# Deployment name (the name YOU chose when deploying the model)
# Recommended: gpt-4o or gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# API Version (use this version for compatibility)
# Version 2024-08-01-preview supports structured outputs
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ----------------------------------------------------------------------------
# MICROSOFT GRAPH CONFIGURATION (Email Delivery)
# ----------------------------------------------------------------------------
# Required for sending daily intelligence briefs via email (Phase 5+)
#
# Where to find these values:
#   1. Navigate to: https://entra.microsoft.com/
#   2. Go to: Applications → App registrations
#   3. Click: New registration (if not already created)
#      - Name: MDInsights Email Service
#      - Supported account types: Single tenant
#      - Redirect URI: Leave blank (daemon app)
#   4. After creation, copy from Overview page:
#      - Directory (tenant) ID → MICROSOFT_TENANT_ID
#      - Application (client) ID → MICROSOFT_CLIENT_ID
#   5. Go to: Certificates & secrets → Client secrets → New client secret
#      - Description: MDInsights Production
#      - Expires: 24 months (IMPORTANT: Set calendar reminder to rotate)
#      - Copy the VALUE (not Secret ID) → MICROSOFT_CLIENT_SECRET
#   6. Go to: API permissions → Add a permission → Microsoft Graph → Application permissions
#      - Add: Mail.Send
#      - Click: Grant admin consent for [Your Org]
#   7. Email address to send FROM (must be valid mailbox in your tenant)
#
# Azure Active Directory Tenant ID (Directory ID)
MICROSOFT_TENANT_ID=your_tenant_id_here

# Application (Client) ID from app registration
MICROSOFT_CLIENT_ID=your_client_id_here

# Client Secret VALUE (not the Secret ID)
# IMPORTANT: Secret expires in 24 months - set reminder to rotate
MICROSOFT_CLIENT_SECRET=your_client_secret_here

# Sender email address (must be valid mailbox in your Microsoft 365 tenant)
# Example: intelligence@marsh.com or mdinsights@yourcompany.com
SENDER_EMAIL=intelligence@yourcompany.com

# ----------------------------------------------------------------------------
# AZURE BLOB STORAGE (Database Backups)
# ----------------------------------------------------------------------------
# Required for automated database backups to Azure (Phase 7)
#
# Where to find this value:
#   1. Navigate to: https://portal.azure.com/
#   2. Search for: "Storage accounts"
#   3. Select or create a storage account
#   4. Go to: Security + networking → Access keys
#   5. Click: Show keys
#   6. Copy: Connection string → AZURE_STORAGE_CONNECTION_STRING
#   7. Container name (will be created automatically if doesn't exist)
#
# Connection string from storage account access keys
# Example: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here

# Container name for storing backups (created automatically if missing)
AZURE_STORAGE_CONTAINER=mdinsights-backups

# Number of days to retain backups (older backups auto-deleted)
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# MMC CORE API CONFIGURATION (Enterprise Integration v1.1)
# ----------------------------------------------------------------------------
# Required for enterprise API access: Factiva news (sole collection source), equity prices, email delivery
#
# Where to find these values:
#   1. Contact the MMC Core API team or check your Apigee developer portal
#   2. You need: client_id, client_secret (for JWT), and an X-Api-Key
#   3. Staging host: mmc-dallas-int-non-prod-ingress.mgti.mmc.com
#   4. Production host: mmc-dallas-int-prod-ingress.mgti.mmc.com
#
# Base URL for the MMC Core API gateway (no trailing slash)
MMC_API_BASE_URL=https://mmc-dallas-int-non-prod-ingress.mgti.mmc.com

# OAuth2 client credentials for JWT token acquisition (Email API only)
MMC_API_CLIENT_ID=your_client_id_here
MMC_API_CLIENT_SECRET=your_client_secret_here

# X-Api-Key for API gateway authentication (all MMC APIs)
MMC_API_KEY=your_api_key_here

# Token endpoint path (change only if Access Management API path differs)
MMC_API_TOKEN_PATH=/coreapi/access-management/v1/token

# Enterprise Email Sender (MMC Core API email endpoint, separate from Graph API)
# The enterprise email path sends via the corporate API proxy with sender impersonation.
# This is a DIFFERENT mailbox from SENDER_EMAIL above (which is for Graph API fallback).
# Leave blank to use Graph API exclusively for email delivery.
MMC_SENDER_EMAIL=kevin.taylor@mmc.com
MMC_SENDER_NAME=Kevin Taylor
# Email endpoint path (change only if the email API path differs from default)
MMC_EMAIL_PATH=/coreapi/email/v1

# ----------------------------------------------------------------------------
# EMAIL RECIPIENTS (Per-Role Distribution)
# ----------------------------------------------------------------------------
# Configure email distribution lists for each role
# Format: Comma-separated email addresses
# Leave blank to disable email delivery for that role
#
# Example for Brokers:
#   REPORT_RECIPIENTS_BROKERS=broker1@marsh.com,broker2@marsh.com
#   REPORT_RECIPIENTS_BROKERS_CC=manager@marsh.com
#   REPORT_RECIPIENTS_BROKERS_BCC=archive@marsh.com
#
# Brokers Role (Front-line sales and client relationships)
REPORT_RECIPIENTS_BROKERS=
REPORT_RECIPIENTS_BROKERS_CC=
REPORT_RECIPIENTS_BROKERS_BCC=

# Leadership Role (Executive decision-makers)
REPORT_RECIPIENTS_LEADERSHIP=
REPORT_RECIPIENTS_LEADERSHIP_CC=
REPORT_RECIPIENTS_LEADERSHIP_BCC=

# Compliance Role (Risk and regulatory monitoring)
REPORT_RECIPIENTS_COMPLIANCE=
REPORT_RECIPIENTS_COMPLIANCE_CC=
REPORT_RECIPIENTS_COMPLIANCE_BCC=

# Underwriting Role (Risk assessment and pricing)
REPORT_RECIPIENTS_UNDERWRITING=
REPORT_RECIPIENTS_UNDERWRITING_CC=
REPORT_RECIPIENTS_UNDERWRITING_BCC=

# Admin email for system failure alerts and monitoring notifications
ADMIN_EMAIL=admin@yourcompany.com

# ----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------------------
# General application settings

# Enable debug mode (verbose logging, detailed errors)
# Production: false | Development: true
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Production: INFO | Development: DEBUG
LOG_LEVEL=INFO

# Web server host binding (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
HOST=0.0.0.0

# Web server port (8001 avoids conflict with BrasilIntel on 8000)
PORT=8001

# ----------------------------------------------------------------------------
# REPORT CUSTOMIZATION
# ----------------------------------------------------------------------------
# Company name appears in email subject lines and report headers
COMPANY_NAME=Marsh
